---
import { Image } from 'astro:assets';
import Page from './Page.astro';
import workbench from '../assets/workbench.png';
const { title, description } = Astro.props;
---
<Page title={`${title} — Kogen Studio`} description={description} analytics={false}>
  <header>
    <a href="/" aria-label="Kogen Studio home"><Image src={workbench} alt="Kogen Studio" width={320} format="webp" /></a>
  </header>
  <main class="information">
    <h1>{title}</h1>
    <slot />
  </main>
</Page>
<style>
  header { max-width: 680px; width: 100%; margin: 0 auto; padding: 36px 24px 0; }
  header a { display: inline-block; padding: 0; }
  header img { display: block; width: 160px; height: auto; }
  .information { display: block; width: 100%; max-width: 680px; margin: 0 auto; padding: 24px 24px 56px; font-size: 17px; line-height: 1.65; }
  h1 { font-size: 32px; line-height: 1.2; font-weight: 400; margin: 0 0 28px; }
  .information :global(h2) { font-size: 21px; line-height: 1.35; font-weight: 400; margin: 32px 0 12px; }
  .information :global(p) { margin: 0 0 20px; }
  .information :global(a) { display: inline; padding: 0; min-height: 0; font-size: inherit; line-height: inherit; letter-spacing: normal; text-decoration: underline; text-underline-offset: 4px; overflow-wrap: anywhere; }
  @media (max-width: 480px) { header { padding-top: 24px; } h1 { font-size: 28px; } }
</style>
