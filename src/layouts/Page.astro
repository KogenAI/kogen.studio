---
import SiteInformationLinks from "../components/SiteInformationLinks.astro";
import AgentMetadata from '../components/AgentMetadata.astro';
interface Props { title?: string; notFound?: boolean }
const { title = 'Kogen Studio', notFound = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content="Kogen Studio product direction around the Kogen feature workflow. Identity website; no Studio application is implemented." />
    {notFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href="https://kogen.studio/" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kogen Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Kogen Studio product direction around the Kogen feature workflow. Identity website; no Studio application is implemented." />
    <meta property="og:url" content="https://kogen.studio/" />
    <meta property="og:image" content="https://kogen.studio/social.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="The Kogen Studio workbench" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Kogen Studio product direction around the Kogen feature workflow. Identity website; no Studio application is implemented." />
    <meta name="twitter:image" content="https://kogen.studio/social.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {!notFound && <script is:inline src="/analytics.js" defer></script>}
  <AgentMetadata notFound={notFound} /></head>
  <body><slot /><SiteInformationLinks /></body>
</html>
<style is:global>
  @font-face { font-family: "IBM Plex Sans"; src: url("../assets/IBMPlexSans-Regular.woff2") format("woff2"); font-weight: 400; font-style: normal; font-display: swap; }
  :root { color-scheme: light; font-family: "IBM Plex Sans", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #171717; background: #fff; }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 240px; }
  main { min-height: 100svh; display: grid; place-items: center; padding: 24px; }
  a { color: #626964; font-size: 13px; line-height: 1.5; text-decoration: none; letter-spacing: .025em; display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 12px; transition: color 180ms ease-out; }
  a:hover { color: #171717; text-decoration: underline; text-underline-offset: 4px; }
  a:focus-visible { outline: 2px solid #171717; outline-offset: 4px; border-radius: 2px; }
  @media (prefers-reduced-motion: reduce) { a { transition: none; } }
</style>
